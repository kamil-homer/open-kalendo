// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  date        DateTime
  location    String?
  link        String?  // np. do zapisu albo na Teams/Zoom
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Article { // baza wiedzy
  id        String   @id @default(cuid())
  title     String
  link      String?  // np. do regulaminu konkursu na stronie
  slug      String   @unique
  content   Json     // rich text z edytora
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}
