// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Event {
  id          String   @id @default(cuid(2))
  title       String
  description String?  @db.Text
  date        DateTime
  location    String?
  link        String?  // np. do zapisu albo na Teams/Zoom
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("event")
}

model Doc { // baza wiedzy
  id        String   @id @default(cuid(2))
  title     String
  link      String?  // np. do regulaminu konkursu na stronie
  slug      String   @unique
  content   Json     // rich text z edytora
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("doc")
}

model User {
  id      String @id @default(cuid(2))
  clerkId String @unique
  email   String @unique

  @@map("user")
}